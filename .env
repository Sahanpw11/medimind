# MediMind local development settings.
# Committed on purpose so the project runs after `git clone` + `npm install` with nothing to configure.
# Every value here is a throwaway local value (no real credentials). Do not reuse them anywhere real.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGODB_DB=medimind_db
JWT_SECRET=local-dev-only-jwt-secret-not-for-real-use
JWT_REFRESH_SECRET=local-dev-only-refresh-secret-not-for-real-use
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=local-dev-only-ai-secret
NODE_ENV=development
PORT=4000
# Sign-in attempts allowed per minute per IP. Raised for local demos and automated tests (the code default is 20).
AUTH_RATE_LIMIT=300
