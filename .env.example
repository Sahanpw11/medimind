# What each setting in .env does. The committed .env already has working local values.
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true   # a replica set is required for transactions
MONGODB_DB=medimind_db                                                         # database name
JWT_SECRET=                                                                    # signs 15-minute access tokens
JWT_REFRESH_SECRET=                                                            # signs 7-day refresh tokens
AI_SERVICE_URL=http://127.0.0.1:8000                                           # where the Node API reaches FastAPI
AI_SERVICE_SECRET=                                                             # shared secret on Node -> FastAPI calls
NODE_ENV=development                                                           # "production" makes missing secrets fatal
PORT=4000                                                                      # Express port
AUTH_RATE_LIMIT=20                                                             # sign-in attempts per minute per IP
