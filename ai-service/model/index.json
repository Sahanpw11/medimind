set":3.890372,"succes":3.890372,"option":3.890372,"age":3.890372,"clear":3.890372,"floor":3.890372,"wear":3.890372,"fall":3.890372,"footwear":3.890372,"social":3.890372,"supportive":3.890372},"docs":[{"id":"EDU-01","title":"Routine checkups","text":"A routine checkup is a regular visit to a doctor when you are not unwell. It usually includes measuring blood pressure, heart rate, height and weight, asking about your lifestyle and family history, and discussing vaccinations or screening tests. Routine checkups help spot health changes early and give you a chance to ask questions.","vec":{"routine":0.432992,"checkup":0.432992,"regular":0.111298,"visit":0.12302,"doctor":0.111298,"unwell":0.181449,"usually":0.162538,"includ":0.149121,"measur":0.162538,"blood":0.116792,"pressure":0.12302,"heart":0.149121,"rate":0.162538,"height":0.162538,"weight":0.138713,"ask":0.234862,"lifestyle":0.162538,"family":0.181449,"history":0.162538,"discuss":0.138713,"vaccination":0.149121,"screen":0.138713,"test":0.138713,"spot":0.181449,"health":0.111298,"chang":0.149121,"early":0.130209,"chance":0.149121,"question":0.162538}},{"id":"EDU-02","title":"Blood pressure basics","text":"Blood pressure is the force of blood against artery walls. It is written as two numbers, systolic over diastolic, for example 120 over 80. Readings are taken at rest. A single high reading does not by itself mean a condition; clinicians look at repeated measurements over time.","vec":{"blood":0.276866,"pressure":0.256472,"basic":0.250822,"force":0.180256,"against":0.161469,"artery":0.180256,"wall":0.180256,"written":0.180256,"two":0.161469,"number":0.180256,"systolic":0.180256,"over":0.271461,"diastolic":0.180256,"example":0.180256,"120":0.180256,"80":0.180256,"read":0.27339,"taken":0.180256,"rest":0.148139,"single":0.180256,"high":0.161469,"itself":0.161469,"condition":0.116023,"clinician":0.081098,"look":0.180256,"repeat":0.180256,"measurement":0.1378,"time":0.161469}},{"id":"EDU-03","title":"What are vital signs","text":"Vital signs are basic measurements of body function: heart rate, blood pressure, breathing rate, body temperature and sometimes oxygen level. They are recorded at most visits so that changes over time can be compared.","vec":{"vital":0.433271,"sign":0.356075,"basic":0.169672,"measurement":0.15783,"body":0.236996,"function":0.206456,"heart":0.169672,"rate":0.313128,"blood":0.132888,"pressure":0.139974,"breath":0.184939,"temperature":0.169672,"sometim":0.184939,"oxygen":0.206456,"level":0.184939,"record":0.148154,"most":0.184939,"visit":0.139974,"chang":0.169672,"over":0.148154,"time":0.184939,"compar":0.184939}},{"id":"EDU-04","title":"Preparing for an appointment","text":"To prepare for a doctor appointment, write down your questions and symptoms, list the medicines and supplements you take, bring relevant documents, and arrive a few minutes early. Being specific about when symptoms started and what makes them better or worse helps the visit.","vec":{"prepar":0.297351,"appointment":0.338134,"prepare":0.196054,"doctor":0.120256,"write":0.196054,"down":0.17562,"question":0.17562,"symptom":0.225055,"list":0.149878,"medicin":0.126192,"supplement":0.17562,"take":0.17562,"bring":0.196054,"relevant":0.196054,"document":0.196054,"arrive":0.196054,"few":0.17562,"minut":0.161123,"early":0.14069,"being":0.196054,"specific":0.196054,"start":0.17562,"mak":0.196054,"better":0.196054,"worse":0.196054,"help":0.149878,"visit":0.132921}},{"id":"EDU-05","title":"Online consultations","text":"An online consultation is a video or phone appointment with a doctor. It suits follow-ups, discussing results and some minor concerns. Find a quiet place with a stable connection. Some problems need an in-person examination, and the doctor will tell you when that is the case.","vec":{"online":0.396265,"consultation":0.396265,"video":0.188823,"phone":0.169143,"appointment":0.15518,"doctor":0.196102,"suit":0.169143,"follow":0.14435,"ups":0.169143,"discuss":0.14435,"result":0.169143,"some":0.262743,"minor":0.169143,"concern":0.169143,"find":0.188823,"quiet":0.169143,"place":0.188823,"stable":0.188823,"connection":0.169143,"problem":0.14435,"need":0.115821,"person":0.188823,"examination":0.188823,"case":0.188823}},{"id":"EDU-06","title":"Understanding allergies","text":"An allergy happens when the immune system reacts to a harmless substance such as pollen, dust mites, certain foods or medicines. Reactions range from mild itching or sneezing to severe reactions. Telling every clinician about your known allergies helps keep your care safe.","vec":{"understand":0.281979,"allergy":0.397417,"happen":0.185918,"immune":0.166541,"system":0.166541,"react":0.185918,"harmles":0.185918,"substance":0.166541,"such":0.109004,"pollen":0.185918,"dust":0.185918,"mit":0.185918,"certain":0.152793,"food":0.152793,"medicin":0.119668,"reaction":0.281979,"range":0.152793,"mild":0.166541,"itch":0.185918,"sneez":0.166541,"severe":0.142129,"tell":0.185918,"every":0.166541,"clinician":0.083646,"known":0.185918,"help":0.142129,"keep":0.114039,"care":0.119668,"safe":0.185918}},{"id":"EDU-07","title":"Medicine allergies and records","text":"If you are allergic to a medicine, such as penicillin, it should be recorded in your health profile with the type of reaction and its severity. Keeping this list up to date helps clinicians avoid prescribing something that could harm you.","vec":{"medicine":0.436034,"allergy":0.315125,"record":0.312901,"allergic":0.207772,"such":0.121817,"penicillin":0.207772,"health":0.127444,"profile":0.207772,"type":0.186118,"reaction":0.186118,"severity":0.207772,"keep":0.127444,"list":0.158836,"up":0.186118,"date":0.207772,"help":0.158836,"clinician":0.093478,"avoid":0.149099,"prescrib":0.207772,"someth":0.186118,"could":0.207772,"harm":0.207772}},{"id":"EDU-08","title":"Diabetes overview","text":"Diabetes is a long-term condition in which the body has trouble regulating blood sugar. Type 1 and type 2 are the main forms. Care often involves regular monitoring, balanced eating, physical activity and medicines chosen by a clinician. Regular follow-up visits are an important part of care.","vec":{"diabet":0.394641,"overview":0.261665,"long":0.134945,"term":0.154544,"condition":0.121039,"body":0.127494,"trouble":0.188048,"regulat":0.188048,"blood":0.121039,"sugar":0.188048,"type":0.28521,"main":0.188048,"form":0.188048,"care":0.204937,"often":0.134945,"involv":0.188048,"regular":0.195298,"monitor":0.168449,"balanc":0.154544,"eat":0.134945,"physical":0.168449,"activity":0.134945,"medicin":0.121039,"chosen":0.188048,"clinician":0.084604,"follow":0.143758,"up":0.168449,"visit":0.127494,"important":0.168449,"part":0.168449}},{"id":"EDU-09","title":"Healthy eating","text":"A balanced diet includes vegetables, fruit, whole grains, legumes and lean protein while limiting sugary drinks, heavily processed foods and excess salt. Eating regular meals and watching portion sizes supports steady energy and healthy weight.","vec":{"healthy":0.294821,"eat":0.276747,"balanc":0.151024,"diet":0.183766,"includ":0.151024,"vegetabl":0.183766,"fruit":0.183766,"whole":0.183766,"grain":0.183766,"legum":0.183766,"lean":0.183766,"protein":0.183766,"while":0.183766,"limit":0.164613,"sugary":0.183766,"drink":0.164613,"heavily":0.183766,"process":0.183766,"food":0.151024,"exces":0.183766,"salt":0.164613,"regular":0.112719,"meal":0.183766,"watch":0.183766,"portion":0.183766,"siz":0.183766,"support":0.112719,"steady":0.183766,"energy":0.183766,"weight":0.140484}},{"id":"EDU-10","title":"Staying hydrated","text":"Water supports temperature control, digestion and circulation. Needs vary with climate, activity and health. Pale yellow urine is a common everyday sign of good hydration. People with certain conditions should follow the fluid advice from their doctor.","vec":{"stay":0.239462,"hydrat":0.353198,"water":0.171437,"support":0.127955,"temperature":0.171437,"control":0.186863,"digestion":0.208604,"circulation":0.208604,"need":0.127955,"vary":0.186863,